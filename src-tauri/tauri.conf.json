{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADM",
  "version": "0.5.8",
  "identifier": "com.adm.admapp",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/prepare-agent-binary.mjs",
    "beforeBuildCommand": "node scripts/prepare-agent-binary.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ADM",
        "width": 1440,
        "height": 800,
        "center": true,
        "minWidth": 1440,
        "minHeight": 800,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [],
    "externalBin": ["binaries/admAgent"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../scripts/sign-windows-file.ps1", "%1"]
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    }
  }
}
